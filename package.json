{
  "name": "luluhgo",
  "productName": "LuluhGo",
  "version": "1.0.0",
  "description": "LuluhGo - compartilhamento de tela em tempo real com áudio.",
  "main": "electron.js",
  "author": "Luana Grimm",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.luanagrimm.luluhgo",
    "productName": "LuluhGo",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "server.js",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "audio-capture/build/Release/LuluhGoAudio.exe",
        "to": "LuluhGoAudio.exe"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "LuluhGo Setup ${version}.${ext}",
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "LuluhGo.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}